RUSTFS_SECRET_KEY=rustfssecretkey
RUSTFS_BUCKET=mediahub
RUSTFS_REGION=us-east-1
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# ==============================================================================
# MediaHub Application Configuration
# ==============================================================================
MEDIAHUB_PORT=8080
MEDIAHUB_ADMIN_PASSWORD=password123
MEDIAHUB_LOGGING_LEVEL=info
